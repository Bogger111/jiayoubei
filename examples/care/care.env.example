# 复制到项目根目录 .env.care.local。Worker 端使用同名 secrets；桥接器独立读取本文件。
CARE_APP_URL=http://localhost:3000
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_FAMILY_ID=F001
CARE_INGEST_SECRET=
CARE_LIGHT_ENTITY=light.jiayoubei_care_care_indicator
# 首次台架用 bench，角色演练用 reenactment，自然试用用 field。软件契约测试用 synthetic。
CARE_CAPTURE_CATEGORY=bench
CARE_CAPTURE_ID=
# 用 HA 实际实体 ID 和应用成员 ID 替换；未列出的实体不会采集或执行。
CARE_ENTITY_MAP={"binary_sensor.jiayoubei_care_care_motion":{"kind":"activity","subjectId":"REPLACE_MEMBER_ID"},"binary_sensor.jiayoubei_care_care_door":{"kind":"door","subjectId":"REPLACE_MEMBER_ID"},"binary_sensor.jiayoubei_care_care_response":{"kind":"reply","subjectId":"REPLACE_MEMBER_ID"},"binary_sensor.jiayoubei_care_care_help":{"kind":"help","subjectId":"REPLACE_MEMBER_ID"},"light.jiayoubei_care_care_indicator":{"kind":"output","subjectId":"REPLACE_MEMBER_ID"}}
