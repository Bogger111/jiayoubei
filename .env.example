# 前端数据适配器：true=示例家庭演示；false=请求本项目的 D1 接口。
VITE_USE_MOCK=true
# 同源部署保持为空；独立后端才填写地址。
VITE_API_BASE_URL=

# 真实模型：填写兼容 Chat Completions 的接口，不要把密钥提交到版本库。
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# 智慧家居：默认 simulator；接入 Home Assistant 时改为 home_assistant。
DEVICE_DRIVER=simulator
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_FAMILY_ID=F001
HA_WEBHOOK_SECRET=

# 本地开发默认 demo；真实部署使用 real 并通过 Worker secrets 配置 AUTH_SECRET。
AUTH_MODE=demo
AUTH_SECRET=
