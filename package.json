{
  "name": "jiayoubei-family-emergency-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --local --show-interactive-dev-session=false",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test tests/product-policy.test.mjs tests/product-selectors.test.mjs tests/product-bootstrap.test.mjs tests/rendered-html.test.mjs tests/fall-detector.test.mjs tests/vision-evidence.test.mjs tests/task-validation.test.mjs tests/analysis-guards.test.mjs tests/db-migrations.test.mjs tests/care-agent.test.mjs tests/care-report.test.mjs tests/multimodal-core.test.mjs tests/showcase.test.mjs tests/home-space-memory.test.mjs tests/scene-plan.test.mjs tests/home-control.test.mjs tests/assistant-tools.test.mjs",
    "test:care:e2e": "node tests/e2e-family-agent.mjs",
    "deck:family": "node scripts/competition/run-care-evidence.mjs && node scripts/competition/build-family-deck.mjs",
    "test:deck:family": "node tests/family-deck-check.mjs",
    "test:cv:e2e": "node tests/e2e-cv.mjs",
    "test:api:local": "node tests/api-local-integrity.mjs",
    "test:e2e": "node tests/e2e-smoke.mjs && node tests/e2e-resource-records.mjs && node tests/e2e-invalid-id.mjs && node tests/e2e-safety-guardrails.mjs && node tests/e2e-dialog-accessibility.mjs && node --test tests/ssr-routes.test.mjs",
    "test:auth:local": "node tests/auth-local-isolated.mjs && node tests/auth-password-isolated.mjs",
    "test:save:real": "node tests/e2e-real-save.mjs",
    "test:invite:e2e": "node tests/e2e-family-invitation.mjs && node tests/e2e-invitation-navigation.mjs",
    "test:session:real": "node tests/e2e-session-boundaries.mjs && node tests/e2e-session-tabs.mjs",
    "test:speech:e2e": "node tests/e2e-speech-input.mjs",
    "test:mobile:e2e": "node tests/e2e-mobile-reading.mjs",
    "test:chat:e2e": "node tests/e2e-chat-reading.mjs",
    "test:production": "node --test tests/production-smoke.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:care:unit": "node --test tests/care-agent.test.mjs",
    "test:care:api": "node tests/care-service-isolated.mjs",
    "test:care:ha": "node tests/care-ha-adapter.mjs",
    "care:replay": "node scripts/care/run-policy-replay.mjs",
    "care:prove": "node scripts/care/prove-p0-browser.mjs",
    "care:report": "node scripts/care/build-evidence-report.mjs",
    "test:care:bridge": "node tests/care-ha-bridge.mjs",
    "test:care:p0": "npm run build && npm run test:care:unit && npm run test:care:api && npm run test:care:ha && npm run test:care:bridge && npm run care:replay && node --test tests/care-report.test.mjs",
    "test:home:unit": "node --test tests/multimodal-core.test.mjs",
    "test:home:api": "node tests/multimodal-service-isolated.mjs",
    "home:prove": "node scripts/integrations/prove-home-agent.mjs",
    "home:verify-vendor": "node scripts/integrations/verify-vendor.mjs",
    "experience:prove": "node scripts/integrations/prove-experience.mjs",
    "showcase:build": "node scripts/competition/build-showcase.mjs",
    "showcase:prove": "node scripts/competition/prove-showcase.mjs",
    "deck:final": "node scripts/competition/build-final-pptx.mjs",
    "test:space:api": "node tests/home-space-memory-api.mjs && node tests/scene-service-api.mjs",
    "test:space:e2e": "node tests/e2e-photo-home.mjs",
    "space:catalog": "node scripts/home/build-furniture-catalog.mjs",
    "test:home-control:api": "node tests/home-control-api.mjs",
    "test:home-control:e2e": "node tests/e2e-home-control.mjs",
    "test:assistant:home": "node tests/e2e-assistant-home.mjs",
    "test:assistant:api": "node tests/assistant-service-api.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@xyflow/react": "12.12.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.34.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.186.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "miniflare": "4.20260515.0",
    "playwright-core": "^1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "ws": "8.18.0"
  },
  "type": "module"
}
