{
  "name": "jiayoubei-family-emergency-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --local --show-interactive-dev-session=false",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test tests/product-policy.test.mjs tests/product-selectors.test.mjs tests/product-bootstrap.test.mjs tests/rendered-html.test.mjs",
    "test:e2e": "node tests/e2e-smoke.mjs && node tests/e2e-invalid-id.mjs && node tests/e2e-safety-guardrails.mjs && node tests/e2e-dialog-accessibility.mjs && node --test tests/ssr-routes.test.mjs",
    "test:production": "node --test tests/production-smoke.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.34.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright-core": "^1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
